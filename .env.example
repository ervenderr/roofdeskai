POSTGRES_PASSWORD=leadpilot
LOCAL_LLM_MODEL=llama3.1:8b
# Optional free-tier fallbacks, tried in order after local Ollama
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Optional: setting this makes Anthropic a live fallback (appended last). Leave blank to keep it off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ADMIN_API_KEY=dev-admin-key
# n8n tenant key map: {"<tenant_id>":"<key>"}. Keys come from POST /admin/tenants/{id}/keys and are never committed.
# Rotating a key = update this value and recreate the n8n container.
TENANT_API_KEYS={}
# Fallback owner/notification address; a pack's meta owner_email overrides it per tenant. Set before deploying.
OWNER_EMAIL=
