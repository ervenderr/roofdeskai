{
  "id": "escalation-alert",
  "name": "Escalation alert",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "error-handler"
  },
  "nodes": [
    {
      "id": "webhook-(web-chat)",
      "name": "Webhook (web chat)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "escalation-alert",
        "responseMode": "onReceived",
        "options": {}
      },
      "position": [
        0,
        0
      ],
      "webhookId": "escalation-alert"
    },
    {
      "id": "called-by-lead-flow",
      "name": "Called by lead flow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": {
        "inputSource": "passthrough"
      },
      "position": [
        0,
        200
      ]
    },
    {
      "id": "normalize-alert",
      "name": "Normalize alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst b = j.body ?? j;\nif (!b.tenant_id || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(b.tenant_id))) throw new Error('alert needs a valid tenant_id');\nreturn [{ json: { tenant_id: String(b.tenant_id), reason: b.reason ?? b.escalation_reason, conversation_id: b.conversation_id, link: b.link } }];"
      },
      "position": [
        260,
        100
      ]
    },
    {
      "id": "notify-human",
      "name": "Notify human",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://mailpit:8025/api/v1/send",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({From: {Email: 'no-reply@roofdesk.test', Name: $json.name}, To: [{Email: $json.owner_email}], Subject: 'Escalation (' + $('Normalize alert').first().json.reason + '): conversation ' + $('Normalize alert').first().json.conversation_id, Text: 'A conversation needs a human. Reason: ' + $('Normalize alert').first().json.reason + '\\nTranscript: ' + $('Normalize alert').first().json.link}) }}"
      },
      "position": [
        980,
        100
      ]
    },
    {
      "id": "tenant-me",
      "name": "Tenant me",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_URL }}/tenant/me",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ JSON.parse($env.TENANT_API_KEYS)[$('Normalize alert').first().json.tenant_id] }}"
            }
          ]
        }
      },
      "position": [
        500,
        100
      ]
    },
    {
      "id": "require-owner",
      "name": "Require owner",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const me = $input.first().json;\nif (!me.owner_email) throw new Error('no owner email for tenant ' + me.slug + ' (set pack meta owner_email or OWNER_EMAIL)');\nreturn [{ json: me }];"
      },
      "position": [
        740,
        100
      ]
    }
  ],
  "connections": {
    "Webhook (web chat)": {
      "main": [
        [
          {
            "node": "Normalize alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Called by lead flow": {
      "main": [
        [
          {
            "node": "Normalize alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize alert": {
      "main": [
        [
          {
            "node": "Tenant me",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tenant me": {
      "main": [
        [
          {
            "node": "Require owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Require owner": {
      "main": [
        [
          {
            "node": "Notify human",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
