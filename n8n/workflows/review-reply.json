{
  "id": "review-reply",
  "name": "Review reply",
  "active": true,
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "review-reply",
        "responseMode": "responseNode",
        "options": {}
      },
      "position": [
        0,
        0
      ],
      "webhookId": "review-reply"
    },
    {
      "id": "normalize",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst b = j.body ?? j;\nconst q = j.query ?? {};\nconst tid = b.tenant_id ?? q.tenant_id;\nif (!tid || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(tid))) throw new Error('payload needs a valid tenant_id');\nif (!b.review_text || !String(b.review_text).trim()) throw new Error('review_text required');\nconst rating = Number(b.rating);\nif (!Number.isInteger(rating) || rating < 1 || rating > 5) throw new Error('rating must be an integer 1-5');\nif (!['google','tripadvisor','other'].includes(b.platform)) throw new Error('platform must be google, tripadvisor or other');\nreturn [{ json: { tenant_id: String(tid), review_text: String(b.review_text), rating, platform: b.platform } }];"
      },
      "position": [
        220,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "id": "reject-bad-payload",
      "name": "Reject bad payload",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({error: $json.error?.message || 'bad payload'}) }}",
        "options": {
          "responseCode": 400
        }
      },
      "position": [
        440,
        200
      ]
    },
    {
      "id": "draft-reply",
      "name": "Draft reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_URL }}/reviews/draft",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ JSON.parse($env.TENANT_API_KEYS)[$('Normalize').first().json.tenant_id] }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ review_text: $json.review_text, rating: $json.rating, platform: $json.platform }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "position": [
        440,
        0
      ]
    },
    {
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({draft_id: $json.id, status: $json.status, deduped: $json.deduped}) }}",
        "options": {}
      },
      "position": [
        660,
        -100
      ]
    },
    {
      "id": "needs-approval",
      "name": "Needs approval",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ !$json.deduped }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        660,
        100
      ]
    },
    {
      "id": "owner-tenant-me",
      "name": "Owner tenant me",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_URL }}/tenant/me",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ JSON.parse($env.TENANT_API_KEYS)[$('Normalize').first().json.tenant_id] }}"
            }
          ]
        }
      },
      "position": [
        880,
        100
      ]
    },
    {
      "id": "require-owner",
      "name": "Require owner",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const me = $input.first().json;\nif (!me.owner_email) throw new Error('no owner email for tenant ' + me.slug + ' (set pack meta owner_email or OWNER_EMAIL)');\nreturn [{ json: me }];"
      },
      "position": [
        1100,
        100
      ]
    },
    {
      "id": "notify-owner",
      "name": "Notify owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://mailpit:8025/api/v1/send",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const d = $('Draft reply').first().json; const p = d.payload || {}; return JSON.stringify({From: {Email: 'no-reply@roofdesk.test', Name: $json.name}, To: [{Email: $json.owner_email}], Subject: 'Review reply draft #' + d.id + ' ready for approval', Text: p.reply_text ? ('Suggested reply:\\n' + p.reply_text) : ('No safe reply could be drafted. Check codes: ' + (p.violations || []).join(', '))}); })() }}"
      },
      "position": [
        1320,
        100
      ]
    },
    {
      "id": "hourly",
      "name": "Hourly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * *"
            }
          ]
        }
      },
      "position": [
        0,
        500
      ]
    },
    {
      "id": "manual",
      "name": "Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "parameters": {},
      "position": [
        0,
        700
      ]
    },
    {
      "id": "list-tenants",
      "name": "List tenants",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_URL }}/admin/tenants",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Admin-Key",
              "value": "={{ $env.ADMIN_API_KEY }}"
            }
          ]
        }
      },
      "position": [
        220,
        600
      ]
    },
    {
      "id": "each-tenant",
      "name": "Each tenant",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "position": [
        440,
        600
      ]
    },
    {
      "id": "check-key",
      "name": "Check key",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const id = $input.first().json.id;\nconst keys = JSON.parse($env.TENANT_API_KEYS || '{}');\nif (!keys[id]) throw new Error('no key for tenant ' + id);  // never log the map\nreturn [{ json: $input.first().json }];"
      },
      "position": [
        660,
        600
      ]
    },
    {
      "id": "tenant-me",
      "name": "Tenant me",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_URL }}/tenant/me",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ JSON.parse($env.TENANT_API_KEYS)[$('Each tenant').first().json.id] }}"
            }
          ]
        }
      },
      "position": [
        880,
        600
      ]
    },
    {
      "id": "list-approved",
      "name": "List approved",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_URL }}/drafts?status=approved&kind=review_reply",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ JSON.parse($env.TENANT_API_KEYS)[$('Each tenant').first().json.id] }}"
            }
          ]
        }
      },
      "position": [
        1100,
        600
      ],
      "alwaysOutputData": true
    },
    {
      "id": "sendable",
      "name": "Sendable",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ $json.payload?.reply_text }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        1320,
        600
      ],
      "alwaysOutputData": true
    },
    {
      "id": "send-mail",
      "name": "Send mail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://mailpit:8025/api/v1/send",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({From: {Email: 'no-reply@roofdesk.test', Name: $('Tenant me').first().json.name}, To: [{Email: $('Tenant me').first().json.owner_email}], Subject: 'Approved review reply #' + $json.id + ' (paste into the review site)', Text: $json.payload.reply_text}) }}"
      },
      "position": [
        1540,
        600
      ],
      "onError": "continueRegularOutput"
    },
    {
      "id": "mail-ok",
      "name": "Mail ok",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ $json.ID }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        1760,
        600
      ],
      "alwaysOutputData": true
    },
    {
      "id": "mark-sent",
      "name": "Mark sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_URL }}/drafts/{{ $('Sendable').item.json.id }}/sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ JSON.parse($env.TENANT_API_KEYS)[$('Each tenant').first().json.id] }}"
            }
          ]
        }
      },
      "position": [
        1980,
        600
      ],
      "onError": "continueRegularOutput"
    },
    {
      "id": "loop-end",
      "name": "Loop end",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: {} }];"
      },
      "position": [
        2200,
        600
      ],
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "note",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "parameters": {
        "content": "There is no review fetcher in this repo: the scheduled lane only polls approved review_reply drafts and mails the final text to the owner, then marks sent. Nothing is ever posted to Google or TripAdvisor.",
        "height": 160,
        "width": 480
      },
      "position": [
        0,
        900
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Normalize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize": {
      "main": [
        [
          {
            "node": "Draft reply",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject bad payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Draft reply": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          },
          {
            "node": "Needs approval",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs approval": {
      "main": [
        [
          {
            "node": "Owner tenant me",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Owner tenant me": {
      "main": [
        [
          {
            "node": "Require owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Require owner": {
      "main": [
        [
          {
            "node": "Notify owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hourly": {
      "main": [
        [
          {
            "node": "List tenants",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual": {
      "main": [
        [
          {
            "node": "List tenants",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List tenants": {
      "main": [
        [
          {
            "node": "Each tenant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Each tenant": {
      "main": [
        [],
        [
          {
            "node": "Check key",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check key": {
      "main": [
        [
          {
            "node": "Tenant me",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tenant me": {
      "main": [
        [
          {
            "node": "List approved",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List approved": {
      "main": [
        [
          {
            "node": "Sendable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sendable": {
      "main": [
        [
          {
            "node": "Send mail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send mail": {
      "main": [
        [
          {
            "node": "Mail ok",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mail ok": {
      "main": [
        [
          {
            "node": "Mark sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark sent": {
      "main": [
        [
          {
            "node": "Loop end",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop end": {
      "main": [
        [
          {
            "node": "Each tenant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "error-handler",
    "saveDataSuccessExecution": "none"
  }
}
