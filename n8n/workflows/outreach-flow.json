    {
      "id": "inbound-reply-webhook",
      "name": "Inbound reply webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "outreach-reply",
        "responseMode": "responseNode",
        "options": {}
      },
      "position": [
        0,
        860
      ],
      "webhookId": "outreach-reply"
    },
    {
      "id": "normalize-reply",
      "name": "Normalize reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? $input.first().json;\nconst raw = b.from ?? b.sender ?? b.email ?? '';\nconst m = String(raw).match(/[^\\s<>\"']+@[^\\s<>\"']+\\.[^\\s<>\"']+/);\nif (!m) throw new Error('reply payload needs a sender address');\nconst type = String(b.type ?? 'reply').toLowerCase();\nconst kind = ['bounce', 'unsubscribe'].includes(type) ? type : 'reply';\nreturn [{ json: { email: m[0].toLowerCase(), kind, body: String(b.text ?? b['body-plain'] ?? b.body ?? '').slice(0, 10000) } }];"
      },
      "position": [
        260,
        860
      ]
    },
