      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const replies = $input.first().json.replies || [];\nreturn replies.filter(r => r.needs_human).map(r => ({ json: r }));  // unsubscribes, bounces and auto-replies need no human"
      },
      "position": [
        520,
        1400
