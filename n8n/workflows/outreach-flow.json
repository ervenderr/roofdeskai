    {
      "id": "format-call-sheet",
      "name": "Format call sheet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nif (!rows.length) return [];  // nobody to call today: stay quiet\nconst lines = rows.map((r, i) => `${i + 1}. ${r.name} (score ${r.score})\\n   Phone: ${r.phone}${r.city ? ' \u00b7 ' + r.city : ''}\\n   ` + r.talking_points.join('\\n   '));\nreturn [{ json: { count: rows.length, text: lines.join('\\n\\n') + '\\n\\nOpener: ' + rows[0].opener + '\\n\\nLog the outcome in the dashboard (Calls page).' } }];"
      },
      "position": [
        520,
        1160
      ]
    },
    {
      "id": "email-me-the-call-sheet",
