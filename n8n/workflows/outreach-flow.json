        "jsonBody": "={{ JSON.stringify({From: {Email: 'no-reply@summitroofing.test', Name: 'RoofDesk AI outreach'}, To: [{Email: 'owner@summitroofing.test'}], Subject: 'Call sheet: ' + $json.count + ' businesses to phone today', Text: $json.text}) }}"
      },
      "position": [
        780,
        1160
      ]
    },
