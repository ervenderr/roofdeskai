      "name": "Note 0. Find prospects",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "parameters": {
        "content": "## 0. Find prospects (Google Maps scraper)\nPOST {campaign_id, queries:[\"dentist in Davao City\"], depth, email} to /webhook/outreach-scrape to start a scrape.\nEvery 5 minutes finished scrapes are imported, deduplicated and scored. Needs the scraper service:\ndocker compose --profile scraper up -d scraper",
        "width": 900,
        "height": 150
      },
      "position": [
        -20,
        -450
      ]
    },
    {
      "id": "start-scrape-webhook",
      "name": "Start scrape webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "outreach-scrape",
        "responseMode": "responseNode",
        "options": {}
      },
      "position": [
        0,
        -340
      ],
      "webhookId": "outreach-scrape"
    },
    {
      "id": "start-google-maps-scrape",
      "name": "Start Google Maps scrape",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_URL }}/admin/scrapes",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Admin-Key",
              "value": "={{ $env.ADMIN_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "position": [
        260,
        -340
      ]
    },
    {
      "id": "scrape-started",
      "name": "Scrape started",
