{
  "id": "quote-request",
  "name": "Quote request",
  "active": true,
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "quote-request",
        "responseMode": "responseNode",
        "options": {}
      },
      "position": [
        0,
        0
      ],
      "webhookId": "quote-request"
    },
    {
      "id": "normalize",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst b = j.body ?? j;\nconst q = j.query ?? {};\nconst tid = b.tenant_id ?? q.tenant_id;\nif (!tid || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(tid))) throw new Error('payload needs a valid tenant_id');\nif (!b.email_text && !b.request) throw new Error('send email_text or request');\nreturn [{ json: { tenant_id: String(tid), ...(b.email_text ? { email_text: String(b.email_text) } : {}), ...(b.request ? { request: b.request } : {}), ...(b.contact_email ? { contact_email: String(b.contact_email) } : {}) } }];"
      },
      "position": [
        220,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "id": "reject-bad-payload",
      "name": "Reject bad payload",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({error: $json.error?.message || 'bad payload'}) }}",
        "options": {
          "responseCode": 400
        }
      },
      "position": [
        440,
        200
      ]
    },
    {
      "id": "create-quote",
      "name": "Create quote",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_URL }}/quotes",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ JSON.parse($env.TENANT_API_KEYS)[$('Normalize').first().json.tenant_id] }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email_text: $json.email_text, request: $json.request, contact_email: $json.contact_email }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "position": [
        440,
        0
      ]
    },
    {
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({draft_id: $json.id, status: $json.status, deduped: $json.deduped}) }}",
        "options": {}
      },
      "position": [
        660,
        -100
      ]
    },
    {
      "id": "needs-approval",
      "name": "Needs approval",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ !$json.deduped && ['pending','needs_human'].includes($json.status) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        660,
        100
      ]
    },
    {
      "id": "owner-tenant-me",
      "name": "Owner tenant me",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_URL }}/tenant/me",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ JSON.parse($env.TENANT_API_KEYS)[$('Normalize').first().json.tenant_id] }}"
            }
          ]
        }
      },
      "position": [
        880,
        100
      ]
    },
    {
      "id": "require-owner",
      "name": "Require owner",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const me = $input.first().json;\nif (!me.owner_email) throw new Error('no owner email for tenant ' + me.slug + ' (set pack meta owner_email or OWNER_EMAIL)');\nreturn [{ json: me }];"
      },
      "position": [
        1100,
        100
      ]
    },
    {
      "id": "notify-owner",
      "name": "Notify owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://mailpit:8025/api/v1/send",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({From: {Email: 'no-reply@roofdesk.test', Name: $json.name}, To: [{Email: $json.owner_email}], Subject: 'Quote draft #' + $('Create quote').first().json.id + ' waiting for approval', Text: 'Quote draft #' + $('Create quote').first().json.id + ' is waiting for approval.'}) }}"
      },
      "position": [
        1320,
        100
      ]
    },
    {
      "id": "every-15-min",
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "position": [
        0,
        500
      ]
    },
    {
      "id": "manual",
      "name": "Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "parameters": {},
      "position": [
        0,
        700
      ]
    },
    {
      "id": "list-tenants",
      "name": "List tenants",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_URL }}/admin/tenants",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Admin-Key",
              "value": "={{ $env.ADMIN_API_KEY }}"
            }
          ]
        }
      },
      "position": [
        220,
        600
      ]
    },
    {
      "id": "each-tenant",
      "name": "Each tenant",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "position": [
        440,
        600
      ]
    },
    {
      "id": "check-key",
      "name": "Check key",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const id = $input.first().json.id;\nconst keys = JSON.parse($env.TENANT_API_KEYS || '{}');\nif (!keys[id]) throw new Error('no key for tenant ' + id);  // never log the map\nreturn [{ json: $input.first().json }];"
      },
      "position": [
        660,
        600
      ]
    },
    {
      "id": "tenant-me",
      "name": "Tenant me",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_URL }}/tenant/me",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ JSON.parse($env.TENANT_API_KEYS)[$('Each tenant').first().json.id] }}"
            }
          ]
        }
      },
      "position": [
        880,
        600
      ]
    },
    {
      "id": "list-approved",
      "name": "List approved",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_URL }}/drafts?status=approved&kind=quote",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ JSON.parse($env.TENANT_API_KEYS)[$('Each tenant').first().json.id] }}"
            }
          ]
        }
      },
      "position": [
        1100,
        600
      ],
      "alwaysOutputData": true
    },
    {
      "id": "sendable",
      "name": "Sendable",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ $json.payload?.contact_email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "c1",
              "leftValue": "={{ $json.payload?.email_text }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        1320,
        600
      ],
      "alwaysOutputData": true
    },
    {
      "id": "send-mail",
      "name": "Send mail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://mailpit:8025/api/v1/send",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({From: {Email: 'no-reply@roofdesk.test', Name: $('Tenant me').first().json.name}, To: [{Email: $json.payload.contact_email}], Subject: 'Your quote from ' + $('Tenant me').first().json.name, Text: $json.payload.email_text}) }}"
      },
      "position": [
        1540,
        600
      ],
      "onError": "continueRegularOutput"
    },
    {
      "id": "mail-ok",
      "name": "Mail ok",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ $json.ID }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        1760,
        600
      ],
      "alwaysOutputData": true
    },
    {
      "id": "mark-sent",
      "name": "Mark sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_URL }}/drafts/{{ $('Sendable').item.json.id }}/sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ JSON.parse($env.TENANT_API_KEYS)[$('Each tenant').first().json.id] }}"
            }
          ]
        }
      },
      "position": [
        1980,
        600
      ],
      "onError": "continueRegularOutput"
    },
    {
      "id": "loop-end",
      "name": "Loop end",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: {} }];"
      },
      "position": [
        2200,
        600
      ],
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "note",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "parameters": {
        "content": "Sender lane: only status=approved quote drafts with contact_email and email_text are mailed to the customer, then POST /drafts/{id}/sent. Others stay approved. At-least-once: a crash between mail and /sent re-sends next run.",
        "height": 160,
        "width": 480
      },
      "position": [
        0,
        900
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Normalize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize": {
      "main": [
        [
          {
            "node": "Create quote",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject bad payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create quote": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          },
          {
            "node": "Needs approval",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs approval": {
      "main": [
        [
          {
            "node": "Owner tenant me",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Owner tenant me": {
      "main": [
        [
          {
            "node": "Require owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Require owner": {
      "main": [
        [
          {
            "node": "Notify owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every 15 min": {
      "main": [
        [
          {
            "node": "List tenants",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual": {
      "main": [
        [
          {
            "node": "List tenants",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List tenants": {
      "main": [
        [
          {
            "node": "Each tenant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Each tenant": {
      "main": [
        [],
        [
          {
            "node": "Check key",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check key": {
      "main": [
        [
          {
            "node": "Tenant me",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tenant me": {
      "main": [
        [
          {
            "node": "List approved",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List approved": {
      "main": [
        [
          {
            "node": "Sendable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sendable": {
      "main": [
        [
          {
            "node": "Send mail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send mail": {
      "main": [
        [
          {
            "node": "Mail ok",
