            "index": 0
          }
        ]
      ]
    },
    "Gate": {
      "main": [
        [
          {
            "node": "Nightly check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Nightly check": {
      "main": [
        [
          {
            "node": "Night alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Night alerts": {
