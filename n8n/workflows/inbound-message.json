{
  "id": "inbound-message",
  "name": "Lead flow (inbound to outcome)",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "error-handler"
  },
  "nodes": [
    {
      "id": "note-##-lead-flow",
      "name": "Note ## Lead flow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "parameters": {
        "content": "## Lead flow\nSMS / GHL-style payload -> agent (FastAPI) -> reply goes back right away.\nThe outcome then branches: booked -> confirmation email, escalated -> alert a human (sub-workflow), nurture -> picked up by the nightly Follow-up scheduler.",
        "width": 760,
        "height": 160
      },
      "position": [
        -20,
        -260
      ]
    },
    {
      "id": "inbound-webhook",
      "name": "Inbound webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "inbound-message",
        "responseMode": "responseNode",
        "options": {}
      },
      "position": [
        0,
        0
      ],
      "webhookId": "inbound-message"
    },
    {
      "id": "normalize-payload",
      "name": "Normalize payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? $input.first().json;\nconst q = $input.first().json.query ?? {};\nconst message = b.body ?? b.message ?? b.text;\nconst contact = b.contactId ?? b.contact_id ?? b.phone ?? b.from;\nconst tid = b.tenant_id ?? q.tenant_id;\nif (!message || !contact) throw new Error('payload needs a message and a contact id');\nif (!tid || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(tid))) throw new Error('payload needs a valid tenant_id');\nconst mid = b.messageId ?? b.message_id;  // the provider's id for this message: lets the API ignore a redelivery\nreturn [{ json: { tenant_id: String(tid), contact_id: String(contact), message: String(message), channel: b.type === 'Email' ? 'email' : 'sms', ...(mid ? { message_id: String(mid) } : {}) } }];"
      },
      "position": [
        240,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "id": "call-agent",
      "name": "Call agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_URL }}/webhooks/inbound",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ JSON.parse($env.TENANT_API_KEYS)[$('Normalize payload').first().json.tenant_id] }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({contact_id: $json.contact_id, message: $json.message, channel: $json.channel, message_id: $json.message_id}) }}"
      },
      "position": [
        480,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "send-reply",
      "name": "Send reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({conversation_id: $json.conversation_id, reply: $json.reply}) }}"
      },
      "position": [
        740,
        -140
      ]
    },
    {
      "id": "route-by-outcome",
      "name": "Route by outcome",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "booked",
                    "leftValue": "={{ $json.outcome }}",
                    "rightValue": "booked",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "booked"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "escalated",
                    "leftValue": "={{ $json.outcome }}",
                    "rightValue": "escalated",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "escalated"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "nurture",
                    "leftValue": "={{ $json.outcome }}",
                    "rightValue": "nurture",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "nurture"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "still talking"
        }
      },
      "position": [
        740,
        100
      ]
    },
    {
      "id": "has-email",
      "name": "Has email?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const j = $input.first().json;\nif (!j.email) return [];  // no email on file: nothing to confirm by email\nreturn [{ json: j }];"
      },
      "position": [
        1000,
        -20
      ]
    },
    {
      "id": "email-booking-confirmation",
      "name": "Email booking confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://mailpit:8025/api/v1/send",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({From: {Email: 'no-reply@roofdesk.test', Name: $('Tenant me').first().json.name}, To: [{Email: $('Has email?').first().json.email}], Subject: 'Your appointment is booked', Text: 'Hi ' + ($('Has email?').first().json.name || 'there') + ',\\n\\nYour appointment is booked for ' + new Date($('Has email?').first().json.appointment_start).toUTCString() + '.\\n\\n' + $('Tenant me').first().json.name}) }}"
      },
      "position": [
        1360,
        -20
      ]
    },
    {
      "id": "alert-a-human",
      "name": "Alert a human",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "escalation-alert",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "position": [
        1120,
        120
      ]
    },
    {
      "id": "leave-to-follow-up-scheduler",
      "name": "Leave to follow-up scheduler",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {},
      "position": [
        1000,
        260
      ]
    },
    {
      "id": "conversation-continues",
      "name": "Conversation continues",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {},
      "position": [
        1000,
        400
      ]
    },
    {
      "id": "reject-bad-payload",
      "name": "Reject bad payload",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        260
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({error: 'payload needs a message, a contact id and a valid tenant_id'}) }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "agent-unavailable",
      "name": "Agent unavailable",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        740,
        260
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({error: 'The assistant is unavailable right now. Please try again shortly.'}) }}",
        "options": {
          "responseCode": 502
        }
      }
    },
    {
      "id": "raise-failure",
      "name": "Raise failure",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1000,
        260
      ],
      "parameters": {
        "errorMessage": "The agent API still failed after 3 tries"
      }
    },
    {
      "id": "tenant-me",
      "name": "Tenant me",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_URL }}/tenant/me",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ JSON.parse($env.TENANT_API_KEYS)[$('Normalize payload').first().json.tenant_id] }}"
            }
          ]
        }
      },
      "position": [
        1120,
        -20
      ]
    },
    {
      "id": "build-alert",
      "name": "Build alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const j = $input.first().json;\nreturn [{ json: { tenant_id: $('Normalize payload').first().json.tenant_id, escalation_reason: j.escalation_reason, conversation_id: j.conversation_id, link: j.link } }];"
      },
      "position": [
        880,
        120
      ]
    }
  ],
  "connections": {
